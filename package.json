{
  "name": "gps-tracker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "GPS track logger for car, motorbike and bicycle. PWA, later wrapped as an Android APK.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "cap:sync": "npm run build && cap sync android",
    "cap:open": "cap open android",
    "cap:run": "npm run build && cap run android"
  },
  "dependencies": {
    "@capacitor-community/background-geolocation": "^1.3.1",
    "@capacitor/android": "^8.6.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/share": "^8.0.3",
    "idb": "^8.0.4",
    "leaflet": "^1.9.4",
    "preact": "^10.27.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.2",
    "@preact/preset-vite": "^2.10.2",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.6.6",
    "fake-indexeddb": "^6.2.8",
    "preact-render-to-string": "^6.8.3",
    "typescript": "^5.9.3",
    "vite": "^7.1.12",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.1"
  }
}
